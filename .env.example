# ============================================================
# Copy to .env and fill in. Only DATABASE_URL is strictly required.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# ============================================================

# ── Required ────────────────────────────────────────────────
# Direct PostgreSQL connection string. The deployed project uses Neon with
# sslmode=require. The "postgresql+asyncpg://" prefix is also accepted and
# normalised automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Gemini key ──────────────────────────────────────────────
# Development convenience only. With ENVIRONMENT=production this fallback is
# DISABLED and every request must carry the user's own X-Gemini-Api-Key header,
# which is the point of the bring-your-own-key design. Leaving a public
# deployment on "development" means anonymous visitors bill your key.
GEMINI_API_KEY=

# ── Environment ─────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# Comma-separated origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Corpus ──────────────────────────────────────────────────
# Tenant that owns the shared Andrew corpus. Optional. Since migration 011,
# sharing is expressed by knowledge_chunks.is_shared, so this is now only used
# to protect the corpus tenant from being cleared.
CORPUS_TENANT_ID=

# ── Retrieval tuning (optional, defaults shown) ─────────────
# The deployed corpus uses Jina 1024-dimensional vectors. Ingestion and
# request-time retrieval must use the same provider, model, and dimensions.
EMBED_PROVIDER=jina
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
EMBED_DIMS=1024
EMBED_BATCH_SIZE=500
EMBED_PACE_SECONDS=62.0

# Used only when EMBED_PROVIDER=local.
EMBED_MODEL=all-mpnet-base-v2
EMBED_WORKERS=2
RETRIEVAL_NEIGHBOR_WINDOW=1       # chunks pulled either side of each hit
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_FTS_WEIGHT=0.35
RETRIEVAL_MIN_COSINE=0.35         # below this an answer is flagged ungrounded
ENABLE_QUERY_REWRITE=true         # rewrite follow-ups into standalone questions

# Gemini generation. Keep these configurable because model retirement follows
# the vendor's calendar, not the application's release cycle.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
REWRITE_MODEL=gemini-3.5-flash-lite
GEMINI_TRIPLET_MODEL=gemini-3.5-flash-lite

# ── Rate limiting (per tenant, per minute) ──────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20                # generation: the expensive path
RATE_LIMIT_TTS=120                # speech synthesis: GPU bound
RATE_LIMIT_READ=240               # graph and session reads: cheap

# ── Text to speech ──────────────────────────────────────────
CHATTERBOX_URL=http://127.0.0.1:5002/v1/audio/speech
MAX_TTS_CHARS=1200

# ── Memory bounds ───────────────────────────────────────────
MAX_CACHE_MANAGERS=128

# ── Frontend ────────────────────────────────────────────────
# Native frontend development uses these values in frontend/.env.local.
# Docker Compose reads them from this root file.
AUTH_SECRET=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
