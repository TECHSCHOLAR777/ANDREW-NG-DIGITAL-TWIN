# ============================================================
# Copy to .env and fill in. Only DATABASE_URL is strictly required.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# ============================================================

# ── Required ────────────────────────────────────────────────
# Supabase Postgres connection string (Settings > Database > Connection string).
# The "postgresql+asyncpg://" prefix is accepted and normalised automatically.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Gemini key ──────────────────────────────────────────────
# Development convenience only. With ENVIRONMENT=production this fallback is
# DISABLED and every request must carry the user's own X-Gemini-Api-Key header,
# which is the point of the bring-your-own-key design. Leaving a public
# deployment on "development" means anonymous visitors bill your key.
GEMINI_API_KEY=

# ── Environment ─────────────────────────────────────────────
# development | production
ENVIRONMENT=development

# Comma-separated origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Corpus ──────────────────────────────────────────────────
# Tenant that owns the shared Andrew corpus. Optional. Since migration 011,
# sharing is expressed by knowledge_chunks.is_shared, so this is now only used
# to protect the corpus tenant from being cleared.
CORPUS_TENANT_ID=

# ── Retrieval tuning (optional, defaults shown) ─────────────
EMBED_MODEL=all-mpnet-base-v2
EMBED_WORKERS=2
RETRIEVAL_NEIGHBOR_WINDOW=1       # chunks pulled either side of each hit
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_FTS_WEIGHT=0.35
RETRIEVAL_MIN_COSINE=0.35         # below this an answer is flagged ungrounded
ENABLE_QUERY_REWRITE=true         # rewrite follow-ups into standalone questions
REWRITE_MODEL=gemini-2.5-flash

# ── Rate limiting (per tenant, per minute) ──────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20                # generation: the expensive path
RATE_LIMIT_TTS=120                # speech synthesis: GPU bound
RATE_LIMIT_READ=240               # graph and session reads: cheap

# ── Text to speech ──────────────────────────────────────────
CHATTERBOX_URL=http://127.0.0.1:5002/v1/audio/speech
MAX_TTS_CHARS=1200

# ── Memory bounds ───────────────────────────────────────────
MAX_CACHE_MANAGERS=128

# ── Frontend ────────────────────────────────────────────────
# Set this in frontend/.env.local, not here.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
